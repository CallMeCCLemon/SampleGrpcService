# ─────────────────────────────────────────────────────────────────────────────
# Dormant in the template: GitHub only picks up files ending in .yml/.yaml.
# `make init` renames this to ci.yml once the project has its own names, so a
# freshly generated repo never deploys over the template's live resources.
#
# CI runs on the shared self-hosted runner registered to the GitHub org (labels
# `self-hosted, k8s`, managed by the platform repo's k8s/runner.yaml). The repo
# must live in that org, and the org runner group must allow it; see README
# "GitHub setup".
#
# Before the first push to main, the cluster needs this project's namespace,
# database, secrets, and Kong mount (README "First deploy"). k8s-rollout will
# create the Deployments if they are missing, but not the rest.
# ─────────────────────────────────────────────────────────────────────────────

name: CI

on:
  pull_request:
    branches: [main]
  push:
    branches: [main]

env:
  # Use the runner's bundled Node 24 for JavaScript actions instead of letting
  # them fetch a pinned version from the GitHub toolcache CDN, which is gated
  # by the cluster's egress rules.
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true

# A newer commit on a PR cancels the in-flight CI run for that PR; main runs
# always serialize so each push tests, builds, and deploys in order. The
# runner is shared across every repo in the org, so jobs may queue behind
# other projects.
concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
  coverage:
    name: Tests + Coverage
    runs-on: [self-hosted, k8s]
    permissions:
      contents: read
      pull-requests: write

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Go coverage + threshold check
        run: make coverage-check

      - name: Render coverage summary
        id: summary
        run: |
          set -eu
          go_total=$(awk '/^total:/ {print $3}' coverage/go-coverage-summary.txt)
          {
            echo "## Coverage"
            echo
            echo "| Suite | Coverage |"
            echo "|---|---|"
            echo "| Go (statements) | ${go_total} |"
            echo
            echo "HTML report is attached as the **coverage-html** artifact on this run."
          } >> "$GITHUB_STEP_SUMMARY"
          echo "go_total=${go_total}" >> "$GITHUB_OUTPUT"

      - name: Upload HTML reports
        uses: actions/upload-artifact@v4
        with:
          name: coverage-html
          path: |
            coverage/go-coverage.html
            coverage/go-coverage-summary.txt

      - name: Sticky PR comment
        if: github.event_name == 'pull_request'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
          REPO: ${{ github.repository }}
          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
          GO_TOTAL: ${{ steps.summary.outputs.go_total }}
        run: |
          set -eu
          MARKER='<!-- coverage-comment -->'
          BODY=$(cat <<EOF
          ${MARKER}
          ## Coverage

          | Suite | Coverage |
          |---|---|
          | Go (statements) | ${GO_TOTAL} |

          [View workflow run](${RUN_URL}) · HTML reports are under the **coverage-html** artifact.
          EOF
          )

          # If the list call fails (e.g. permissions hiccup), `gh api` writes its
          # error JSON to stderr and exits non-zero. `|| true` keeps the step
          # alive so we can fall through to creating a fresh comment, and the
          # numeric-ID guard prevents PATCHing with a garbage value.
          existing=$(gh api "repos/${REPO}/issues/${PR_NUMBER}/comments" \
            --jq ".[] | select(.body | contains(\"${MARKER}\")) | .id" | head -n1 || true)
          case "${existing}" in
            ''|*[!0-9]*) gh pr comment "${PR_NUMBER}" --repo "${REPO}" --body "${BODY}" ;;
            *)           gh api -X PATCH "repos/${REPO}/issues/comments/${existing}" -f body="${BODY}" ;;
          esac

  integration-tests:
    name: Integration tests
    runs-on: [self-hosted, k8s]
    permissions:
      contents: read
    timeout-minutes: 10

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      # Type-checks the -tags=integration files before paying for Docker.
      - name: Vet integration tests
        run: make vet-integration

      - name: Wait for Docker daemon
        run: timeout 30 sh -c 'until docker info >/dev/null 2>&1; do sleep 1; done'

      - name: Run integration tests
        run: make test-integration

      # The runner's Docker storage is a capped per-pod emptyDir; overflowing
      # it evicts the pod mid-job. See the action.
      - name: Reclaim DinD disk
        if: always()
        uses: ./.github/actions/reclaim-dind

  # The two image builds run as separate jobs so they land on whichever
  # runners are free. They do not wait for tests; `deploy` is the gate.
  build-backend:
    name: Docker Build (backend)
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    runs-on: [self-hosted, k8s]

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          # Full history so `git rev-parse --short HEAD` in the Makefile works.
          fetch-depth: 0

      - name: Set up Docker Buildx
        run: |
          timeout 30 sh -c 'until docker info >/dev/null 2>&1; do sleep 1; done'
          make ci-builder

      - name: Build backend image
        run: make docker-build

      - name: Reclaim DinD disk
        if: always()
        uses: ./.github/actions/reclaim-dind

  build-web:
    name: Docker Build (web)
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    runs-on: [self-hosted, k8s]

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Docker Buildx
        run: |
          timeout 30 sh -c 'until docker info >/dev/null 2>&1; do sleep 1; done'
          make ci-builder

      - name: Build web image
        run: make web-docker-build

      - name: Reclaim DinD disk
        if: always()
        uses: ./.github/actions/reclaim-dind

  deploy:
    name: K8s Rollout
    # The real gate: nothing untested reaches the cluster.
    needs: [build-backend, build-web, coverage, integration-tests]
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    runs-on: [self-hosted, k8s]

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      # `kubectl set image` with the SHA tag forces a real rollout every
      # commit; applying the :latest-pinned manifest would be a no-op.
      - name: Roll out deployments
        run: make k8s-rollout

      # Runs after the rollout so the live-tag lookup sees the new image.
      - name: Prune stale registry tags (project-scoped)
        run: make registry-prune

  # Only refreshes this project's proto configmap + Ingress, and only restarts
  # Kong when the protos changed. Never runs `helm upgrade kong`: the Helm
  # release is shared platform infrastructure. Needs deploy because
  # deployment.yaml creates the namespace kong.yaml's resources live in.
  kong-deploy:
    name: Deploy Kong routes
    needs: [deploy]
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    runs-on: [self-hosted, k8s]

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Deploy Kong
        run: make kong-deploy
